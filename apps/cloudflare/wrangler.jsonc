{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glyph-atlas",
  "main": "src/index.ts",
  "account_id": "5e6d5236e83c2395b253db1ec8e28a3e",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "atlas.mkpo.li", "custom_domain": true}],
  "assets": {
    "directory": "../review/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/atlas*", "/layers*", "/forms*", "/images/*", "/health", "/history"]
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "d1_databases": [{"binding": "DB", "database_name": "glyph-atlas", "database_id": "556cb20f-db02-4f2a-8044-f7fd86776db6", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "glyph-atlas"}]
}
