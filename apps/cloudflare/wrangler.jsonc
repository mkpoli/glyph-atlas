{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glyph-atlas",
  "main": "src/entry.js",
  "account_id": "5e6d5236e83c2395b253db1ec8e28a3e",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // atlas.mkpo.li and www.glyphatlas.org answer with 301s to this host from Redirect Rules on their zones.
  "routes": [{"pattern": "glyphatlas.org", "custom_domain": true}],
  "assets": {
    "directory": "../review/.svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  // ATLAS and ATLAS_RUNS are the storage layout (docs/decisions/0005-storage-rebuild.md), filled by scripts/atlas3.
  "d1_databases": [{"binding": "ATLAS", "database_name": "glyph-atlas-v3", "database_id": "0b475d45-dfe4-49a6-8c44-996289e82995", "migrations_dir": "migrations-atlas"},
                   {"binding": "ATLAS_RUNS", "database_name": "glyph-atlas-v3-runs", "database_id": "61a9e757-1343-4e4e-801b-f9c23f66b531", "migrations_dir": "migrations-atlas-runs"},
                   // ACCOUNTS holds the users, sessions and sign-in accounts: the cutover copies the auth tables
                   // into it with scripts/atlas3/accounts.py, then applies migrations-accounts.
                   {"binding": "ACCOUNTS", "database_name": "glyph-atlas-accounts", "database_id": "d2f3d824-cb72-4db9-9d83-fe16ebe5b141", "migrations_dir": "migrations-accounts"}],
  // Every hour the Worker finishes account deletions that stopped between the two databases (`src/entry.js`).
  "triggers": {"crons": ["17 * * * *"]},
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "glyph-atlas"}],
  // Sign-in codes are sent from MAIL_FROM, on a domain onboarded to Email Sending.
  "send_email": [{"name": "EMAIL"}],
  // SIMILAR_INDEX_NAME names the Vectorize index bound as SIMILAR_INDEX, whose pointer the image search reads.
  // CATALOGUE_LAG is how many seconds the edge's copies may stand behind the reviews (`catalogueStamps`).
  // MATRIX_HOMESERVER and MATRIX_INBOX_ROOM are where contact-form messages go (`src/contact.ts`), posted
  // with the inbox account's token, the secret MATRIX_INBOX_TOKEN. Mail routed to the Worker (contact@) is
  // forwarded to the secret CONTACT_FORWARD_TO, which must be a verified Email Routing destination, and
  // posted to the same room.
  "vars": {"MAIL_FROM": "sign-in@glyphatlas.org", "SIMILAR_INDEX_NAME": "glyph-atlas-similar-5dc40a3e", "CATALOGUE_LAG": "60",
           "MATRIX_HOMESERVER": "https://matrix.glyphatlas.org", "MATRIX_INBOX_ROOM": "!Vg3g9ktsIY_VWsL5i6K10iqJX1cuvi-GeEWXTeLPuJw"},
  // BETTER_AUTH_SECRET is a secret, and so is each sign-in provider's app id and secret (GITHUB_CLIENT_ID,
  // GITHUB_CLIENT_SECRET, and GOOGLE_, DISCORD_, LINE_ and KAKAO_ likewise); a provider without them is not offered.
  // BETTER_AUTH_SECRET: `wrangler secret put BETTER_AUTH_SECRET`, and `.dev.vars` locally.
  // WRITES_PAUSED is the write freeze (`src/freeze.ts`): while it is "1", every request that writes to the
  // database (reviews, rounds, corrections, claims, favourites, form decisions, sign-in and sign-up, passkeys,
  // account and admin changes) answers 503 `paused` with a Retry-After, and reads go on, a signed-in
  // session's included. It is a secret so that it takes effect without a build: `echo 1 | wrangler secret
  // put WRITES_PAUSED` to freeze, `wrangler secret delete WRITES_PAUSED` to lift it. Each of these deploys a
  // new version at once, and refuses while a newer version is uploaded and not deployed; such a version gets
  // `wrangler versions secret put/delete` instead, which makes another version without deploying it. It is
  // never a var here, since a var of the same name would block the secret.
  // Batch corrections change up to 144 crops a request; one address gets 20 of them a minute. A claim,
  // an action on one or a crop's form names one crop, a batch of forms up to 48; one address gets 30
  // of these a minute.
  "ratelimits": [{"name": "CORRECTIONS", "namespace_id": "4401", "simple": {"limit": 20, "period": 60}},
                 {"name": "CLAIMS", "namespace_id": "4403", "simple": {"limit": 30, "period": 60}},
                 // An image search is a few Vectorize queries and record reads; one address gets 30 a minute.
                 {"name": "REVERSE_QUERIES", "namespace_id": "4404", "simple": {"limit": 30, "period": 60}},
                 // A sign-in code is a mail; one address receives two a minute through each Cloudflare location.
                 {"name": "SIGN_IN_MAIL", "namespace_id": "4405", "simple": {"limit": 2, "period": 60}},
                 // A contact-form message goes to the maintainers' inbox; one address sends three a minute.
                 {"name": "CONTACT", "namespace_id": "4406", "simple": {"limit": 3, "period": 60}},
                 // A browser claims its one old reviewer id on sign-in; one address may send three a minute.
                 {"name": "OLD_IDS", "namespace_id": "4407", "simple": {"limit": 3, "period": 60}}],
  // The image search's vectors, one index per classifier encoder (`glyph-atlas-similar-<encoder[:8]>`).
  // `scripts/publish_reverse.sh create` makes it and `publish` fills it; it has to exist before a deploy,
  // and SIMILAR_INDEX_NAME above names it too.
  "vectorize": [{"binding": "SIMILAR_INDEX", "index_name": "glyph-atlas-similar-5dc40a3e"}]
}
