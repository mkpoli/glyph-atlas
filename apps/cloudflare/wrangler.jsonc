{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glyph-atlas",
  "main": "../review/.svelte-kit/cloudflare/_worker.js",
  "account_id": "5e6d5236e83c2395b253db1ec8e28a3e",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // atlas.mkpo.li and www.glyphatlas.org answer with 301s to this host from Redirect Rules on their zones.
  "routes": [{"pattern": "glyphatlas.org", "custom_domain": true}],
  "assets": {
    "directory": "../review/.svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "d1_databases": [{"binding": "DB", "database_name": "glyph-atlas", "database_id": "556cb20f-db02-4f2a-8044-f7fd86776db6", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "glyph-atlas"}],
  // Batch corrections change up to 144 crops a request; one address gets 20 of them a minute. A written
  // form names one crop, and one address gets 30 a minute.
  "ratelimits": [{"name": "CORRECTIONS", "namespace_id": "4401", "simple": {"limit": 20, "period": 60}},
                 {"name": "WRITTEN_FORMS", "namespace_id": "4402", "simple": {"limit": 30, "period": 60}}]
}
